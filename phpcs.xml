<?xml version="1.0"?>
<ruleset name="WP YetiSearch">
    <description>WordPress Coding Standards for WP YetiSearch.</description>

    <file>src</file>
    <file>wp-yetisearch.php</file>
    <file>uninstall.php</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/vendor-prefixed/*</exclude-pattern>

    <arg name="extensions" value="php"/>

    <rule ref="WordPress"/>

    <!--
        Deliberate exclusions (PSR-4/PSR-12 codebase; PHPStan level 8 is the
        correctness gate, PHPCS guards WP API usage and security patterns):
        - FileName: PSR-4 autoloading requires ClassName.php (class-*.php would break it).
        - ValidVariableName/ValidFunctionName: camelCase per PSR-12, used consistently.
        - YodaConditions: non-Yoda per PSR-12; logic is covered by 195 unit tests.
        - Squiz/Generic commenting: doc prose style; types are enforced by PHPStan.
    -->
    <rule ref="WordPress.Files.FileName">
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
    </rule>
    <rule ref="WordPress.NamingConventions.ValidVariableName">
        <exclude name="WordPress.NamingConventions.ValidVariableName.VariableNotSnakeCase"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase"/>
        <exclude name="WordPress.NamingConventions.ValidVariableName.PropertyNotSnakeCase"/>
    </rule>
    <rule ref="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid">
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.PHP.YodaConditions">
        <severity>0</severity>
    </rule>
    <rule ref="Squiz.Commenting">
        <severity>0</severity>
    </rule>
    <rule ref="Generic.Commenting.DocComment">
        <severity>0</severity>
    </rule>

    <!--
        Plugin-owned scratch files under uploads (logs, index, markers):
        WP_Filesystem's credential flow is inappropriate; direct calls with
        explicit error checks are deliberate.
    -->
    <rule ref="WordPress.WP.AlternativeFunctions">
        <exclude-pattern>*/src/Core/FileLog.php</exclude-pattern>
        <exclude-pattern>*/src/Core/HealthChecker.php</exclude-pattern>
        <exclude-pattern>*/src/Storage/ServerSecurity.php</exclude-pattern>
        <exclude-pattern>*/src/Storage/StorageManager.php</exclude-pattern>
        <exclude-pattern>*/uninstall.php</exclude-pattern>
    </rule>
    <rule ref="WordPress.PHP.NoSilencedErrors">
        <exclude-pattern>*/src/Core/FileLog.php</exclude-pattern>
        <exclude-pattern>*/src/Core/HealthChecker.php</exclude-pattern>
        <exclude-pattern>*/src/Storage/ServerSecurity.php</exclude-pattern>
        <exclude-pattern>*/src/Storage/StorageManager.php</exclude-pattern>
        <exclude-pattern>*/uninstall.php</exclude-pattern>
    </rule>
    <!-- WP-CLI dispatches ($args, $assoc_args) by API contract even when unused. -->
    <rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
        <exclude-pattern>*/src/Cli/*</exclude-pattern>
    </rule>

</ruleset>
