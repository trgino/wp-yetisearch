#. Plugin Name of the plugin
#: wp-yetisearch.php
msgid "WP YetiSearch"
msgstr ""

#. Plugin URI of the plugin
#: wp-yetisearch.php
msgid "https://github.com/trgino/wp-yetisearch"
msgstr ""

#. Description of the plugin
#: wp-yetisearch.php
msgid "Fast, typo-tolerant and semantic search for WordPress powered by SQLite FTS5 (YetiSearch)."
msgstr "Schnelle, fehlertolerante und semantische Suche für WordPress auf Basis von SQLite FTS5 (YetiSearch)."

#. Author of the plugin
#: wp-yetisearch.php
msgid "trgino"
msgstr ""

#: Admin/FieldLabels.php:15
msgid "General"
msgstr "Allgemein"

#: Admin/FieldLabels.php:16
msgid "Content"
msgstr "Inhalte"

#: Admin/FieldLabels.php:17
msgid "Relevance"
msgstr "Relevanz"

#: Admin/FieldLabels.php:18
msgid "Language"
msgstr "Sprache"

#: Admin/FieldLabels.php:19
msgid "Display"
msgstr "Anzeige"

#: Admin/FieldLabels.php:20
msgid "Facets & Geo"
msgstr "Facetten & Geo"

#: Admin/FieldLabels.php:21
msgid "Semantic"
msgstr "Semantik"

#: Admin/FieldLabels.php:22
msgid "Performance"
msgstr "Leistung"

#: Admin/FieldLabels.php:23
msgid "Maintenance"
msgstr "Wartung"

#: Admin/FieldLabels.php:47
#: Admin/Views/tab-general.php:46
msgid "Enable YetiSearch"
msgstr "YetiSearch aktivieren"

#: Admin/FieldLabels.php:47
msgid "Take over front-end search. Locked until health checks pass."
msgstr "Frontend-Suche übernehmen. Gesperrt, bis die Systemprüfungen erfolgreich sind."

#: Admin/FieldLabels.php:48
#: Admin/Views/tab-general.php:55
msgid "Custom database directory"
msgstr "Benutzerdefiniertes Datenbankverzeichnis"

#: Admin/FieldLabels.php:48
#: Admin/Views/tab-general.php:58
msgid "Absolute path; outside the web root is safest. Empty means uploads/yetisearch/."
msgstr "Absoluter Pfad; außerhalb des Web-Stammverzeichnisses ist am sichersten. Leer bedeutet uploads/yetisearch/."

#: Admin/FieldLabels.php:49
msgid "Post types to index"
msgstr "Zu indexierende Beitragstypen"

#: Admin/FieldLabels.php:49
msgid "Only published, password-less posts are indexed. Changing this requires a re-index."
msgstr "Es werden nur veröffentlichte Beiträge ohne Passwortschutz indexiert. Eine Änderung erfordert eine Neuindexierung."

#: Admin/FieldLabels.php:50
msgid "Taxonomies to index"
msgstr "Zu indexierende Taxonomien"

#: Admin/FieldLabels.php:50
msgid "Term names become searchable text. Requires a re-index."
msgstr "Begriffsnamen werden zu durchsuchbarem Text. Erfordert eine Neuindexierung."

#: Admin/FieldLabels.php:51
msgid "Meta keys to index"
msgstr "Zu indexierende Metaschlüssel"

#: Admin/FieldLabels.php:51
msgid "One key per line. Requires a re-index."
msgstr "Ein Schlüssel pro Zeile. Erfordert eine Neuindexierung."

#: Admin/FieldLabels.php:52
msgid "Chunk size"
msgstr "Abschnittsgröße"

#: Admin/FieldLabels.php:52
msgid "Long posts are split into chunks of this many characters. Requires a re-index."
msgstr "Lange Beiträge werden in Abschnitte dieser Zeichenanzahl aufgeteilt. Erfordert eine Neuindexierung."

#: Admin/FieldLabels.php:53
msgid "Chunk overlap"
msgstr "Abschnittsüberlappung"

#: Admin/FieldLabels.php:53
msgid "Overlap between neighboring chunks, at most half the chunk size. Requires a re-index."
msgstr "Überlappung zwischen benachbarten Abschnitten, höchstens die halbe Abschnittsgröße. Erfordert eine Neuindexierung."

#: Admin/FieldLabels.php:54
msgid "Title weight"
msgstr "Titelgewichtung"

#: Admin/FieldLabels.php:54
#: Admin/FieldLabels.php:55
#: Admin/FieldLabels.php:56
#: Admin/FieldLabels.php:57
#: Admin/FieldLabels.php:58
msgid "Applied at query time; no re-index needed."
msgstr "Wird zur Abfragezeit angewendet; keine Neuindexierung erforderlich."

#: Admin/FieldLabels.php:55
msgid "Content weight"
msgstr "Inhaltsgewichtung"

#: Admin/FieldLabels.php:56
msgid "Excerpt weight"
msgstr "Auszugsgewichtung"

#: Admin/FieldLabels.php:57
msgid "Taxonomies weight"
msgstr "Taxonomiegewichtung"

#: Admin/FieldLabels.php:58
msgid "Meta weight"
msgstr "Metagewichtung"

#: Admin/FieldLabels.php:59
msgid "Minimum score"
msgstr "Mindestpunktzahl"

#: Admin/FieldLabels.php:59
msgid "Results below this BM25 score are dropped. Keep 0 unless noisy results appear on large sites."
msgstr "Ergebnisse unterhalb dieser BM25-Punktzahl werden verworfen. Belassen Sie 0, sofern auf großen Websites keine unpassenden Ergebnisse erscheinen."

#: Admin/FieldLabels.php:60
msgid "Two-pass search"
msgstr "Zweistufige Suche"

#: Admin/FieldLabels.php:60
msgid "Search primary fields first, then the full index."
msgstr "Zuerst die primären Felder durchsuchen, dann den vollständigen Index."

#: Admin/FieldLabels.php:61
msgid "Primary fields"
msgstr "Primäre Felder"

#: Admin/FieldLabels.php:61
msgid "Fields searched in the first pass."
msgstr "Felder, die im ersten Durchgang durchsucht werden."

#: Admin/FieldLabels.php:62
msgid "Primary field limit"
msgstr "Limit für primäre Felder"

#: Admin/FieldLabels.php:62
msgid "Maximum candidates taken from the first pass."
msgstr "Maximale Anzahl der Kandidaten aus dem ersten Durchgang."

#: Admin/FieldLabels.php:63
msgid "Exact match boost"
msgstr "Verstärkung für exakte Treffer"

#: Admin/FieldLabels.php:63
msgid "Multiplier for exact phrase matches."
msgstr "Multiplikator für exakte Phrasentreffer."

#: Admin/FieldLabels.php:64
msgid "Exact terms boost"
msgstr "Verstärkung für exakte Begriffe"

#: Admin/FieldLabels.php:64
msgid "Multiplier when all exact terms are present."
msgstr "Multiplikator, wenn alle exakten Begriffe vorhanden sind."

#: Admin/FieldLabels.php:65
msgid "Fuzzy search"
msgstr "Fehlertolerante Suche"

#: Admin/FieldLabels.php:65
msgid "Tolerate typos via trigram / Jaro-Winkler / Levenshtein consensus."
msgstr "Toleriert Tippfehler mittels Trigramm-/Jaro-Winkler-/Levenshtein-Konsens."

#: Admin/FieldLabels.php:66
msgid "Fuzzy algorithm"
msgstr "Fuzzy-Algorithmus"

#: Admin/FieldLabels.php:66
msgid "Which similarity measure drives typo correction."
msgstr "Welches Ähnlichkeitsmaß die Tippfehlerkorrektur steuert."

#: Admin/FieldLabels.php:67
msgid "Fuzzy correction mode"
msgstr "Fuzzy-Korrekturmodus"

#: Admin/FieldLabels.php:67
msgid "Rewrite the query to the corrected terms before searching."
msgstr "Schreibt die Suchanfrage vor der Suche auf die korrigierten Begriffe um."

#: Admin/FieldLabels.php:68
msgid "Correction threshold"
msgstr "Korrekturschwelle"

#: Admin/FieldLabels.php:68
msgid "Minimum confidence for applying a typo correction."
msgstr "Mindestzuverlässigkeit für die Anwendung einer Tippfehlerkorrektur."

#: Admin/FieldLabels.php:69
msgid "Levenshtein threshold"
msgstr "Levenshtein-Schwelle"

#: Admin/FieldLabels.php:69
msgid "Maximum edit distance for Levenshtein matches."
msgstr "Maximale Editierdistanz für Levenshtein-Treffer."

#: Admin/FieldLabels.php:70
msgid "Trigram threshold"
msgstr "Trigramm-Schwelle"

#: Admin/FieldLabels.php:70
msgid "Minimum trigram similarity for fuzzy matches."
msgstr "Mindest-Trigramm-Ähnlichkeit für fehlertolerante Treffer."

#: Admin/FieldLabels.php:71
msgid "Jaro-Winkler threshold"
msgstr "Jaro-Winkler-Schwelle"

#: Admin/FieldLabels.php:71
msgid "Minimum Jaro-Winkler similarity for fuzzy matches."
msgstr "Mindest-Jaro-Winkler-Ähnlichkeit für fehlertolerante Treffer."

#: Admin/FieldLabels.php:72
msgid "Minimum term frequency"
msgstr "Mindest-Termhäufigkeit"

#: Admin/FieldLabels.php:72
msgid "A term must occur this often before it can be a correction target."
msgstr "Ein Begriff muss so häufig vorkommen, bevor er als Korrekturziel dienen kann."

#: Admin/FieldLabels.php:73
msgid "Fuzzy score penalty"
msgstr "Fuzzy-Punktabzug"

#: Admin/FieldLabels.php:73
msgid "Score discount applied to fuzzy-corrected matches."
msgstr "Punktabzug für fuzzy-korrigierte Treffer."

#: Admin/FieldLabels.php:74
msgid "Fuzzy last token only"
msgstr "Fuzzy nur für letztes Token"

#: Admin/FieldLabels.php:74
msgid "Apply typo correction to the last query token only."
msgstr "Wendet die Tippfehlerkorrektur nur auf das letzte Such-Token an."

#: Admin/FieldLabels.php:75
msgid "Prefix last token"
msgstr "Letztes Token als Präfix"

#: Admin/FieldLabels.php:75
msgid "Match the last token as a prefix. Requires a re-index (FTS prefix index)."
msgstr "Das letzte Token als Präfix abgleichen. Erfordert eine Neuindexierung (FTS-Präfixindex)."

#: Admin/FieldLabels.php:76
#: Frontend/Assets.php:44
msgid "Search suggestions"
msgstr "Suchvorschläge"

#: Admin/FieldLabels.php:76
msgid "Offer \"did you mean\" suggestions for typo queries."
msgstr "Bietet „Meinten Sie“-Vorschläge für Suchanfragen mit Tippfehlern an."

#: Admin/FieldLabels.php:77
msgid "Stemmer language"
msgstr "Stemmer-Sprache"

#: Admin/FieldLabels.php:77
msgid "Auto detects English/French/German/Spanish. Requires a re-index."
msgstr "Erkennt Englisch/Französisch/Deutsch/Spanisch automatisch. Erfordert eine Neuindexierung."

#: Admin/FieldLabels.php:78
msgid "Minimum word length"
msgstr "Mindestwortlänge"

#: Admin/FieldLabels.php:78
msgid "Shorter tokens are dropped at index time. Requires a re-index."
msgstr "Kürzere Token werden beim Indexieren verworfen. Erfordert eine Neuindexierung."

#: Admin/FieldLabels.php:79
msgid "Strip punctuation"
msgstr "Satzzeichen entfernen"

#: Admin/FieldLabels.php:79
msgid "Remove punctuation during analysis. Requires a re-index."
msgstr "Entfernt Satzzeichen während der Analyse. Erfordert eine Neuindexierung."

#: Admin/FieldLabels.php:80
msgid "Expand contractions"
msgstr "Kontraktionen erweitern"

#: Admin/FieldLabels.php:80
msgid "Expand don't → do not etc. Requires a re-index."
msgstr "Erweitert don't → do not usw. Erfordert eine Neuindexierung."

#: Admin/FieldLabels.php:81
msgid "Custom stop words"
msgstr "Benutzerdefinierte Stoppwörter"

#: Admin/FieldLabels.php:81
msgid "One word per line. Requires a re-index."
msgstr "Ein Wort pro Zeile. Erfordert eine Neuindexierung."

#: Admin/FieldLabels.php:82
msgid "Disable stop words"
msgstr "Stoppwörter deaktivieren"

#: Admin/FieldLabels.php:82
msgid "Index even the most common words. Requires a re-index."
msgstr "Auch die häufigsten Wörter indexieren. Erfordert eine Neuindexierung."

#: Admin/FieldLabels.php:83
msgid "Enable synonyms"
msgstr "Synonyme aktivieren"

#: Admin/FieldLabels.php:83
msgid "Expand queries with the synonym map below."
msgstr "Erweitert Suchanfragen mit der untenstehenden Synonymzuordnung."

#: Admin/FieldLabels.php:84
msgid "Synonyms"
msgstr "Synonyme"

#: Admin/FieldLabels.php:84
msgid "One per line: term: synonym1, synonym2"
msgstr "Eines pro Zeile: Begriff: Synonym1, Synonym2"

#: Admin/FieldLabels.php:85
msgid "Highlight matches"
msgstr "Treffer hervorheben"

#: Admin/FieldLabels.php:85
msgid "Wrap matching terms in the highlight tag."
msgstr "Übereinstimmende Begriffe in das Hervorhebungs-Tag einschließen."

#: Admin/FieldLabels.php:86
msgid "Highlight tag"
msgstr "Hervorhebungs-Tag"

#: Admin/FieldLabels.php:86
msgid "Only this tag is allowed in highlight HTML; everything else is escaped."
msgstr "Nur dieses Tag ist im Hervorhebungs-HTML zulässig; alles andere wird maskiert."

#: Admin/FieldLabels.php:87
msgid "Snippet length"
msgstr "Snippet-Länge"

#: Admin/FieldLabels.php:87
msgid "Characters shown around each match."
msgstr "Zeichen, die um jeden Treffer herum angezeigt werden."

#: Admin/FieldLabels.php:88
msgid "Typeahead suggestions"
msgstr "Vorschläge bei der Eingabe"

#: Admin/FieldLabels.php:88
msgid "Suggest results while typing in search fields."
msgstr "Schlägt Ergebnisse während der Eingabe in Suchfeldern vor."

#: Admin/FieldLabels.php:89
msgid "Typeahead selector"
msgstr "Selektor für Vorschläge bei der Eingabe"

#: Admin/FieldLabels.php:89
msgid "CSS selector for search inputs to enhance."
msgstr "CSS-Selektor für zu erweiternde Sucheingaben."

#: Admin/FieldLabels.php:90
msgid "Typeahead debounce (ms)"
msgstr "Verzögerung für Vorschläge bei der Eingabe (ms)"

#: Admin/FieldLabels.php:90
msgid "Wait this long after typing stops before searching."
msgstr "So lange nach Ende der Eingabe warten, bevor gesucht wird."

#: Admin/FieldLabels.php:91
msgid "Typeahead minimum characters"
msgstr "Mindestzeichen für Vorschläge bei der Eingabe"

#: Admin/FieldLabels.php:91
msgid "Start suggesting after this many characters."
msgstr "Vorschläge ab dieser Zeichenanzahl anzeigen."

#: Admin/FieldLabels.php:92
msgid "Typeahead maximum results"
msgstr "Maximale Ergebnisse für Vorschläge bei der Eingabe"

#: Admin/FieldLabels.php:92
msgid "Suggestions shown per keystroke."
msgstr "Vorschläge, die pro Tasteneingabe angezeigt werden."

#: Admin/FieldLabels.php:93
msgid "Enable facets"
msgstr "Facetten aktivieren"

#: Admin/FieldLabels.php:93
msgid "Count results per post type and taxonomy."
msgstr "Zählt Ergebnisse pro Beitragstyp und Taxonomie."

#: Admin/FieldLabels.php:94
msgid "Post type facet"
msgstr "Beitragstyp-Facette"

#: Admin/FieldLabels.php:94
msgid "Include a post-type facet in results."
msgstr "Eine Beitragstyp-Facette in die Ergebnisse aufnehmen."

#: Admin/FieldLabels.php:95
msgid "Facet taxonomies"
msgstr "Facetten-Taxonomien"

#: Admin/FieldLabels.php:95
msgid "Only the primary term per post is counted. Requires a re-index."
msgstr "Es wird nur der Hauptbegriff pro Beitrag gezählt. Erfordert eine Neuindexierung."

#: Admin/FieldLabels.php:96
msgid "Facet limit"
msgstr "Facetten-Limit"

#: Admin/FieldLabels.php:96
msgid "Values returned per facet."
msgstr "Werte, die pro Facette zurückgegeben werden."

#: Admin/FieldLabels.php:97
msgid "Enable geo search"
msgstr "Geo-Suche aktivieren"

#: Admin/FieldLabels.php:97
msgid "Without SQLite R-Tree, results stay exact but queries are slower. Requires a re-index."
msgstr "Ohne SQLite R-Tree bleiben die Ergebnisse exakt, aber Abfragen sind langsamer. Erfordert eine Neuindexierung."

#: Admin/FieldLabels.php:98
msgid "Latitude meta key"
msgstr "Breitengrad-Metaschlüssel"

#: Admin/FieldLabels.php:98
msgid "Post meta key holding the latitude. Requires a re-index."
msgstr "Beitrags-Metaschlüssel für den Breitengrad. Erfordert eine Neuindexierung."

#: Admin/FieldLabels.php:99
msgid "Longitude meta key"
msgstr "Längengrad-Metaschlüssel"

#: Admin/FieldLabels.php:99
msgid "Post meta key holding the longitude. Requires a re-index."
msgstr "Beitrags-Metaschlüssel für den Längengrad. Erfordert eine Neuindexierung."

#: Admin/FieldLabels.php:100
msgid "Default radius"
msgstr "Standardradius"

#: Admin/FieldLabels.php:100
msgid "In the unit selected below."
msgstr "In der unten ausgewählten Einheit."

#: Admin/FieldLabels.php:101
msgid "Distance unit"
msgstr "Entfernungseinheit"

#: Admin/FieldLabels.php:101
msgid "Kilometers or miles."
msgstr "Kilometer oder Meilen."

#: Admin/FieldLabels.php:102
msgid "Distance ranges"
msgstr "Entfernungsbereiche"

#: Admin/FieldLabels.php:102
msgid "Comma-separated ranges for the distance facet."
msgstr "Kommagetrennte Bereiche für die Entfernungs-Facette."

#: Admin/FieldLabels.php:103
msgid "Distance weight"
msgstr "Entfernungsgewichtung"

#: Admin/FieldLabels.php:103
msgid "How strongly distance influences ranking (0–1)."
msgstr "Wie stark die Entfernung das Ranking beeinflusst (0–1)."

#: Admin/FieldLabels.php:104
msgid "Price facet"
msgstr "Preis-Facette"

#: Admin/FieldLabels.php:104
msgid "Bucket results by price ranges below. Prices index automatically; no re-index needed to toggle."
msgstr "Teilt Ergebnisse in die untenstehenden Preisbereiche ein. Preise werden automatisch indexiert; zum Umschalten ist keine Neuindexierung erforderlich."

#: Admin/FieldLabels.php:105
msgid "Price meta key"
msgstr "Preis-Metaschlüssel"

#: Admin/FieldLabels.php:105
msgid "Post meta key holding the numeric price (WooCommerce: _price). Requires a re-index."
msgstr "Beitrags-Metaschlüssel für den numerischen Preis (WooCommerce: _price). Erfordert eine Neuindexierung."

#: Admin/FieldLabels.php:106
msgid "Price ranges"
msgstr "Preisbereiche"

#: Admin/FieldLabels.php:106
msgid "Comma-separated upper bounds, e.g. 100, 500, 1000. Applied at query time."
msgstr "Kommagetrennte Obergrenzen, z. B. 100, 500, 1000. Wird zur Abfragezeit angewendet."

#: Admin/FieldLabels.php:107
msgid "Enable semantic search"
msgstr "Semantische Suche aktivieren"

#: Admin/FieldLabels.php:107
msgid "Hybrid keyword + embedding search via an OpenAI-compatible API."
msgstr "Hybride Stichwort- + Embedding-Suche über eine OpenAI-kompatible API."

#: Admin/FieldLabels.php:108
msgid "Embedding endpoint"
msgstr "Embedding-Endpunkt"

#: Admin/FieldLabels.php:108
msgid "Base URL, e.g. https://api.openai.com/v1 or http://localhost:11434/v1"
msgstr "Basis-URL, z. B. https://api.openai.com/v1 oder http://localhost:11434/v1"

#: Admin/FieldLabels.php:109
msgid "API key"
msgstr "API-Schlüssel"

#: Admin/FieldLabels.php:109
msgid "Write-only: blank keeps the stored key. YETISEARCH_SEMANTIC_API_KEY wins."
msgstr "Nur Schreiben: Leer lässt den gespeicherten Schlüssel unverändert. YETISEARCH_SEMANTIC_API_KEY hat Vorrang."

#: Admin/FieldLabels.php:110
msgid "Embedding model"
msgstr "Embedding-Modell"

#: Admin/FieldLabels.php:110
msgid "Model id sent to the embedding endpoint."
msgstr "Modell-ID, die an den Embedding-Endpunkt gesendet wird."

#: Admin/FieldLabels.php:111
msgid "Dimensions"
msgstr "Dimensionen"

#: Admin/FieldLabels.php:111
msgid "0 means auto-detect from the first response."
msgstr "0 bedeutet automatische Erkennung aus der ersten Antwort."

#: Admin/FieldLabels.php:112
msgid "Query prefix"
msgstr "Abfragepräfix"

#: Admin/FieldLabels.php:112
msgid "Prepended to queries, e.g. for nomic-embed-text."
msgstr "Wird Abfragen vorangestellt, z. B. für nomic-embed-text."

#: Admin/FieldLabels.php:113
msgid "Document prefix"
msgstr "Dokumentpräfix"

#: Admin/FieldLabels.php:113
msgid "Prepended to indexed documents."
msgstr "Wird indexierten Dokumenten vorangestellt."

#: Admin/FieldLabels.php:114
msgid "Semantic weight"
msgstr "Semantische Gewichtung"

#: Admin/FieldLabels.php:114
msgid "Hybrid balance between keyword and vector scores."
msgstr "Hybride Balance zwischen Stichwort- und Vektor-Punktzahlen."

#: Admin/FieldLabels.php:115
msgid "Minimum similarity"
msgstr "Mindestähnlichkeit"

#: Admin/FieldLabels.php:115
msgid "Vector hits below this are discarded."
msgstr "Vektortreffer unterhalb dieses Werts werden verworfen."

#: Admin/FieldLabels.php:116
msgid "Minimum margin"
msgstr "Mindestabstand"

#: Admin/FieldLabels.php:116
msgid "Noise gate: semantic must beat keyword by this margin."
msgstr "Rauschgrenze: Semantik muss Stichwort um diesen Abstand übertreffen."

#: Admin/FieldLabels.php:117
msgid "Calibration"
msgstr "Kalibrierung"

#: Admin/FieldLabels.php:117
msgid "Auto measures the noise floor; off disables the gate."
msgstr "Auto misst das Grundrauschen; Aus deaktiviert die Grenze."

#: Admin/FieldLabels.php:118
msgid "Calibration strictness"
msgstr "Kalibrierungsstrenge"

#: Admin/FieldLabels.php:118
msgid "Higher rejects more semantic noise."
msgstr "Höher lehnt mehr semantisches Rauschen ab."

#: Admin/FieldLabels.php:119
msgid "Embedding batch size"
msgstr "Embedding-Stapelgröße"

#: Admin/FieldLabels.php:119
msgid "Documents embedded per cron/AJAX batch."
msgstr "Dokumente, die pro Cron-/AJAX-Stapel mit Embeddings versehen werden."

#: Admin/FieldLabels.php:120
msgid "Query timeout (s)"
msgstr "Abfrage-Timeout (s)"

#: Admin/FieldLabels.php:120
msgid "Embedding calls slower than this fall back to keyword search."
msgstr "Embedding-Aufrufe, die langsamer sind, fallen auf die Stichwortsuche zurück."

#: Admin/FieldLabels.php:121
msgid "Semantic in typeahead"
msgstr "Semantik in Vorschlägen bei der Eingabe"

#: Admin/FieldLabels.php:121
msgid "Off by default to keep keystroke latency low."
msgstr "Standardmäßig deaktiviert, um die Latenz bei der Eingabe niedrig zu halten."

#: Admin/FieldLabels.php:122
msgid "Embed via cron"
msgstr "Embeddings per Cron"

#: Admin/FieldLabels.php:122
msgid "Embed pending documents every five minutes."
msgstr "Verseht ausstehende Dokumente alle fünf Minuten mit Embeddings."

#: Admin/FieldLabels.php:123
msgid "Query cache"
msgstr "Abfrage-Cache"

#: Admin/FieldLabels.php:123
msgid "Cache search results for repeated queries."
msgstr "Speichert Suchergebnisse für wiederholte Abfragen im Cache."

#: Admin/FieldLabels.php:124
msgid "Cache TTL (s)"
msgstr "Cache-TTL (s)"

#: Admin/FieldLabels.php:124
msgid "How long cached results stay valid."
msgstr "Wie lange zwischengespeicherte Ergebnisse gültig bleiben."

#: Admin/FieldLabels.php:125
msgid "Cache max size"
msgstr "Maximale Cache-Größe"

#: Admin/FieldLabels.php:125
msgid "Maximum cached queries held."
msgstr "Maximale Anzahl gehaltener zwischengespeicherter Abfragen."

#: Admin/FieldLabels.php:126
msgid "Warm-up queries"
msgstr "Warm-up-Abfragen"

#: Admin/FieldLabels.php:126
msgid "One per line; replayed after clearing the cache."
msgstr "Eine pro Zeile; werden nach dem Leeren des Cache erneut ausgeführt."

#: Admin/FieldLabels.php:127
msgid "SQLite synchronous"
msgstr "SQLite-Synchronmodus"

#: Admin/FieldLabels.php:127
msgid "FULL is safer, NORMAL is faster."
msgstr "FULL ist sicherer, NORMAL ist schneller."

#: Admin/FieldLabels.php:128
msgid "Maximum results"
msgstr "Maximale Ergebnisse"

#: Admin/FieldLabels.php:128
msgid "De-duplication window pulled per search."
msgstr "Deduplizierungsfenster, das pro Suche abgerufen wird."

#: Admin/FieldLabels.php:129
msgid "Search mode"
msgstr "Suchmodus"

#: Admin/FieldLabels.php:129
msgid "Fast uses the engine total (may include removed posts); verified recounts public posts within the result window (slower transfer). Items are always verified."
msgstr "Schnell verwendet die Engine-Gesamtzahl (kann entfernte Beiträge enthalten); Verifiziert zählt öffentliche Beiträge im Ergebnisfenster erneut (langsamere Übertragung). Einträge werden stets geprüft."

#: Admin/SettingsPage.php:40
#: Admin/SettingsPage.php:41
#: Admin/Views/layout.php:22
msgid "WpYetiSearch\\Vendor\\YetiSearch"
msgstr ""

#: Admin/SettingsPage.php:112
msgid "YetiSearch settings changed the index schema. Please re-index on the Maintenance tab."
msgstr "YetiSearch-Einstellungen haben das Indexschema geändert. Bitte indexieren Sie auf der Registerkarte „Wartung“ neu."

#: Admin/Views/field.php:61
msgid "Clear stored key"
msgstr "Gespeicherten Schlüssel löschen"

#: Admin/Views/layout.php:24
msgid "Index schema changed — please re-index on the Maintenance tab."
msgstr "Indexschema geändert — bitte indexieren Sie auf der Registerkarte „Wartung“ neu."

#: Admin/Views/tab-general.php:16
msgid "System health"
msgstr "Systemzustand"

#: Admin/Views/tab-general.php:22
msgid "OK"
msgstr "OK"

#: Admin/Views/tab-general.php:22
msgid "FAIL"
msgstr "FEHLER"

#: Admin/Views/tab-general.php:29
msgid "Re-check"
msgstr "Erneut prüfen"

#. translators: %s: human-readable time difference, e.g. "2 hours"
#: Admin/Views/tab-general.php:35
#, php-format
msgid "Last checked %s ago. Automatic checks run hourly."
