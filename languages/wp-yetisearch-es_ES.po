#. Description of the plugin
#: wp-yetisearch.php
msgid "Fast, typo-tolerant and semantic search for WordPress powered by SQLite FTS5 (YetiSearch)."
msgstr "Búsqueda rápida, tolerante a erratas y semántica para WordPress con SQLite FTS5 (YetiSearch)."

#. Author of the plugin
#: wp-yetisearch.php
msgid "trgino"
msgstr ""

