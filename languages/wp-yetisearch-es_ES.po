msgstr "Mantenimiento"

#: Admin/FieldLabels.php:47
#: Admin/Views/tab-general.php:46
msgid "Enable YetiSearch"
msgstr "Activar YetiSearch"

#: Admin/FieldLabels.php:47
msgid "Take over front-end search. Locked until health checks pass."
msgstr "Toma el control de la búsqueda del sitio. Bloqueado hasta que pasen las comprobaciones de estado."

#: Admin/FieldLabels.php:48
#: Admin/Views/tab-general.php:55
msgid "Custom database directory"
msgstr "Directorio personalizado de la base de datos"

#: Admin/FieldLabels.php:48
#: Admin/Views/tab-general.php:58
msgid "Absolute path; outside the web root is safest. Empty means uploads/yetisearch/."
msgstr "Ruta absoluta; fuera de la raíz web es lo más seguro. Vacío significa uploads/yetisearch/."

#: Admin/FieldLabels.php:49
msgid "Post types to index"
msgstr "Tipos de contenido que indexar"

#: Admin/FieldLabels.php:49
msgid "Only published, password-less posts are indexed. Changing this requires a re-index."
msgstr "Solo se indexan los contenidos publicados y sin contraseña. Cambiar esto requiere una reindexación."

#: Admin/FieldLabels.php:50
msgid "Taxonomies to index"
msgstr "Taxonomías que indexar"

#: Admin/FieldLabels.php:50
msgid "Term names become searchable text. Requires a re-index."
msgstr "Los nombres de los términos se convierten en texto buscable. Requiere una reindexación."

#: Admin/FieldLabels.php:51
msgid "Meta keys to index"
msgstr "Claves meta que indexar"

#: Admin/FieldLabels.php:51
msgid "One key per line. Requires a re-index."
msgstr "Una clave por línea. Requiere una reindexación."

#: Admin/FieldLabels.php:52
msgid "Chunk size"
msgstr "Tamaño de fragmento"

#: Admin/FieldLabels.php:52
msgid "Long posts are split into chunks of this many characters. Requires a re-index."
msgstr "Las entradas largas se dividen en fragmentos de este número de caracteres. Requiere una reindexación."

#: Admin/FieldLabels.php:53
msgid "Chunk overlap"
msgstr "Solapamiento de fragmentos"

#: Admin/FieldLabels.php:53
msgid "Overlap between neighboring chunks, at most half the chunk size. Requires a re-index."
msgstr "Solapamiento entre fragmentos vecinos, como máximo la mitad del tamaño del fragmento. Requiere una reindexación."

#: Admin/FieldLabels.php:54
msgid "Title weight"
msgstr "Peso del título"

#: Admin/FieldLabels.php:54
#: Admin/FieldLabels.php:55
#: Admin/FieldLabels.php:56
#: Admin/FieldLabels.php:57
#: Admin/FieldLabels.php:58
msgid "Applied at query time; no re-index needed."
msgstr "Se aplica al buscar; no requiere reindexación."

#: Admin/FieldLabels.php:55
msgid "Content weight"
msgstr "Peso del contenido"

#: Admin/FieldLabels.php:56
msgid "Excerpt weight"
msgstr "Peso del extracto"

#: Admin/FieldLabels.php:57
msgid "Taxonomies weight"
msgstr "Peso de las taxonomías"

#: Admin/FieldLabels.php:58
msgid "Meta weight"
msgstr "Peso de los metadatos"

#: Admin/FieldLabels.php:59
msgid "Minimum score"
msgstr "Puntuación mínima"

#: Admin/FieldLabels.php:59
msgid "Results below this BM25 score are dropped. Keep 0 unless noisy results appear on large sites."
msgstr "Los resultados por debajo de esta puntuación BM25 se descartan. Mantén 0 salvo que aparezcan resultados ruidosos en sitios grandes."

#: Admin/FieldLabels.php:60
msgid "Two-pass search"
msgstr "Búsqueda en dos pasadas"

#: Admin/FieldLabels.php:60
msgid "Search primary fields first, then the full index."
msgstr "Busca primero en los campos principales y luego en el índice completo."

#: Admin/FieldLabels.php:61
msgid "Primary fields"
msgstr "Campos principales"

#: Admin/FieldLabels.php:61
msgid "Fields searched in the first pass."
msgstr "Campos en los que se busca en la primera pasada."

#: Admin/FieldLabels.php:62
msgid "Primary field limit"
msgstr "Límite de campos principales"

#: Admin/FieldLabels.php:62
msgid "Maximum candidates taken from the first pass."
msgstr "Máximo de candidatos tomados de la primera pasada."

#: Admin/FieldLabels.php:63
msgid "Exact match boost"
msgstr "Impulso por coincidencia exacta"

#: Admin/FieldLabels.php:63
msgid "Multiplier for exact phrase matches."
msgstr "Multiplicador para coincidencias de frase exacta."

#: Admin/FieldLabels.php:64
msgid "Exact terms boost"
msgstr "Impulso por términos exactos"

#: Admin/FieldLabels.php:64
msgid "Multiplier when all exact terms are present."
msgstr "Multiplicador cuando están presentes todos los términos exactos."

#: Admin/FieldLabels.php:65
msgid "Fuzzy search"
msgstr "Búsqueda difusa"

#: Admin/FieldLabels.php:65
msgid "Tolerate typos via trigram / Jaro-Winkler / Levenshtein consensus."
msgstr "Tolera erratas mediante consenso de trigramas / Jaro-Winkler / Levenshtein."

#: Admin/FieldLabels.php:66
msgid "Fuzzy algorithm"
msgstr "Algoritmo difuso"

#: Admin/FieldLabels.php:66
msgid "Which similarity measure drives typo correction."
msgstr "Qué medida de similitud dirige la corrección de erratas."

#: Admin/FieldLabels.php:67
msgid "Fuzzy correction mode"
msgstr "Modo de corrección difusa"

#: Admin/FieldLabels.php:67
msgid "Rewrite the query to the corrected terms before searching."
msgstr "Reescribe la consulta con los términos corregidos antes de buscar."

#: Admin/FieldLabels.php:68
msgid "Correction threshold"
msgstr "Umbral de corrección"

#: Admin/FieldLabels.php:68
msgid "Minimum confidence for applying a typo correction."
msgstr "Confianza mínima para aplicar una corrección de erratas."

#: Admin/FieldLabels.php:69
msgid "Levenshtein threshold"
msgstr "Umbral de Levenshtein"

#: Admin/FieldLabels.php:69
msgid "Maximum edit distance for Levenshtein matches."
msgstr "Distancia máxima de edición para coincidencias de Levenshtein."

#: Admin/FieldLabels.php:70
msgid "Trigram threshold"
msgstr "Umbral de trigramas"

#: Admin/FieldLabels.php:70
msgid "Minimum trigram similarity for fuzzy matches."
msgstr "Similitud mínima de trigramas para coincidencias difusas."

#: Admin/FieldLabels.php:71
msgid "Jaro-Winkler threshold"
msgstr "Umbral de Jaro-Winkler"

#: Admin/FieldLabels.php:71
msgid "Minimum Jaro-Winkler similarity for fuzzy matches."
msgstr "Similitud mínima de Jaro-Winkler para coincidencias difusas."

#: Admin/FieldLabels.php:72
msgid "Minimum term frequency"
msgstr "Frecuencia mínima del término"

#: Admin/FieldLabels.php:72
msgid "A term must occur this often before it can be a correction target."
msgstr "Un término debe aparecer con esta frecuencia para poder ser objetivo de corrección."

#: Admin/FieldLabels.php:73
msgid "Fuzzy score penalty"
msgstr "Penalización difusa de puntuación"

#: Admin/FieldLabels.php:73
msgid "Score discount applied to fuzzy-corrected matches."
msgstr "Descuento de puntuación aplicado a las coincidencias corregidas."

#: Admin/FieldLabels.php:74
msgid "Fuzzy last token only"
msgstr "Corregir solo el último término"

#: Admin/FieldLabels.php:74
msgid "Apply typo correction to the last query token only."
msgstr "Aplica la corrección de erratas solo al último término de la consulta."

#: Admin/FieldLabels.php:75
msgid "Prefix last token"
msgstr "Prefijo en el último término"

#: Admin/FieldLabels.php:75
msgid "Match the last token as a prefix. Requires a re-index (FTS prefix index)."
msgstr "Busca el último término como prefijo. Requiere una reindexación (índice de prefijos FTS)."

#: Admin/FieldLabels.php:76
#: Frontend/Assets.php:44
msgid "Search suggestions"
msgstr "Sugerencias de búsqueda"

#: Admin/FieldLabels.php:76
msgid "Offer \"did you mean\" suggestions for typo queries."
msgstr "Ofrece sugerencias de «quisiste decir» para consultas con erratas."

#: Admin/FieldLabels.php:77
msgid "Stemmer language"
msgstr "Idioma del lematizador"

#: Admin/FieldLabels.php:77
msgid "Auto uses the site language. Indexes stem in their content language. Requires a re-index."
msgstr ""

#: Admin/FieldLabels.php:78
msgid "Minimum word length"
msgstr "Longitud mínima de palabra"

#: Admin/FieldLabels.php:78
msgid "Shorter tokens are dropped at index time. Requires a re-index."
msgstr "Los términos más cortos se descartan al indexar. Requiere una reindexación."

#: Admin/FieldLabels.php:79
msgid "Strip punctuation"
msgstr "Eliminar puntuación"

#: Admin/FieldLabels.php:79
msgid "Remove punctuation during analysis. Requires a re-index."
msgstr "Elimina la puntuación durante el análisis. Requiere una reindexación."

#: Admin/FieldLabels.php:80
msgid "Expand contractions"
msgstr "Expandir contracciones"

#: Admin/FieldLabels.php:80
msgid "Expand don't → do not etc. Requires a re-index."
msgstr "Expande don't → do not, etc. Requiere una reindexación."

#: Admin/FieldLabels.php:81
msgid "Custom stop words"
msgstr "Palabras vacías personalizadas"

#: Admin/FieldLabels.php:81
msgid "One word per line. Requires a re-index."
msgstr "Una palabra por línea. Requiere una reindexación."

#: Admin/FieldLabels.php:82
msgid "Disable stop words"
msgstr "Desactivar palabras vacías"

#: Admin/FieldLabels.php:82
msgid "Index even the most common words. Requires a re-index."
msgstr "Indexa incluso las palabras más comunes. Requiere una reindexación."

#: Admin/FieldLabels.php:83
msgid "Enable synonyms"
msgstr "Activar sinónimos"

#: Admin/FieldLabels.php:83
msgid "Expand queries with the synonym map below."
msgstr "Amplía las consultas con el mapa de sinónimos siguiente."

#: Admin/FieldLabels.php:84
msgid "Synonyms"
msgstr "Sinónimos"

#: Admin/FieldLabels.php:84
msgid "One per line: term: synonym1, synonym2"
msgstr "Uno por línea: término: sinónimo1, sinónimo2"

#: Admin/FieldLabels.php:85
msgid "Highlight matches"
msgstr "Resaltar coincidencias"

#: Admin/FieldLabels.php:85
msgid "Wrap matching terms in the highlight tag."
msgstr "Envuelve los términos coincidentes en la etiqueta de resaltado."

#: Admin/FieldLabels.php:86
msgid "Highlight tag"
msgstr "Etiqueta de resaltado"

#: Admin/FieldLabels.php:86
msgid "Only this tag is allowed in highlight HTML; everything else is escaped."
msgstr "Solo esta etiqueta está permitida en el HTML de resaltado; todo lo demás se escapa."

#: Admin/FieldLabels.php:87
msgid "Snippet length"
msgstr "Longitud del fragmento"

#: Admin/FieldLabels.php:87
msgid "Characters shown around each match."
msgstr "Caracteres mostrados alrededor de cada coincidencia."

#: Admin/FieldLabels.php:88
msgid "Typeahead suggestions"
msgstr "Sugerencias predictivas"

#: Admin/FieldLabels.php:88
msgid "Suggest results while typing in search fields."
msgstr "Sugiere resultados mientras escribes en los campos de búsqueda."

#: Admin/FieldLabels.php:89
msgid "Typeahead selector"
msgstr "Selector de sugerencias predictivas"

#: Admin/FieldLabels.php:89
msgid "CSS selector for search inputs to enhance."
msgstr "Selector CSS de los campos de búsqueda que mejorar."

#: Admin/FieldLabels.php:90
msgid "Typeahead debounce (ms)"
msgstr "Retardo de sugerencias predictivas (ms)"

#: Admin/FieldLabels.php:90
msgid "Wait this long after typing stops before searching."
msgstr "Espera este tiempo tras dejar de escribir antes de buscar."

#: Admin/FieldLabels.php:91
msgid "Typeahead minimum characters"
msgstr "Caracteres mínimos para sugerencias"

#: Admin/FieldLabels.php:91
msgid "Start suggesting after this many characters."
msgstr "Empieza a sugerir a partir de este número de caracteres."

#: Admin/FieldLabels.php:92
msgid "Typeahead maximum results"
msgstr "Máximo de sugerencias predictivas"

#: Admin/FieldLabels.php:92
msgid "Suggestions shown per keystroke."
msgstr "Sugerencias mostradas por cada pulsación."

#: Admin/FieldLabels.php:93
msgid "Enable facets"
msgstr "Activar facetas"

#: Admin/FieldLabels.php:93
msgid "Count results per post type and taxonomy."
msgstr "Cuenta resultados por tipo de contenido y taxonomía."

#: Admin/FieldLabels.php:94
msgid "Post type facet"
msgstr "Faceta de tipo de contenido"

#: Admin/FieldLabels.php:94
msgid "Include a post-type facet in results."
msgstr "Incluye una faceta de tipo de contenido en los resultados."

#: Admin/FieldLabels.php:95
msgid "Facet taxonomies"
msgstr "Taxonomías de facetas"

#: Admin/FieldLabels.php:95
msgid "Only the primary term per post is counted. Requires a re-index."
msgstr "Solo se cuenta el término principal de cada entrada. Requiere una reindexación."

#: Admin/FieldLabels.php:96
msgid "Facet limit"
msgstr "Límite de facetas"

#: Admin/FieldLabels.php:96
msgid "Values returned per facet."
msgstr "Valores devueltos por faceta."

#: Admin/FieldLabels.php:97
msgid "Enable geo search"
msgstr "Activar búsqueda geográfica"

#: Admin/FieldLabels.php:97
msgid "Without SQLite R-Tree, results stay exact but queries are slower. Requires a re-index."
msgstr "Sin R-Tree de SQLite, los resultados siguen siendo exactos pero las consultas son más lentas. Requiere una reindexación."

#: Admin/FieldLabels.php:98
msgid "Latitude meta key"
msgstr "Clave meta de latitud"

#: Admin/FieldLabels.php:98
msgid "Post meta key holding the latitude. Requires a re-index."
msgstr "Clave meta de la entrada que contiene la latitud. Requiere una reindexación."

#: Admin/FieldLabels.php:99
msgid "Longitude meta key"
msgstr "Clave meta de longitud"

#: Admin/FieldLabels.php:99
msgid "Post meta key holding the longitude. Requires a re-index."
msgstr "Clave meta de la entrada que contiene la longitud. Requiere una reindexación."

#: Admin/FieldLabels.php:100
msgid "Default radius"
msgstr "Radio predeterminado"

#: Admin/FieldLabels.php:100
msgid "In the unit selected below."
msgstr "En la unidad seleccionada abajo."

#: Admin/FieldLabels.php:101
msgid "Distance unit"
msgstr "Unidad de distancia"

#: Admin/FieldLabels.php:101
msgid "Kilometers or miles."
msgstr "Kilómetros o millas."

#: Admin/FieldLabels.php:102
msgid "Distance ranges"
msgstr "Rangos de distancia"

#: Admin/FieldLabels.php:102
msgid "Comma-separated ranges for the distance facet."
msgstr "Rangos separados por comas para la faceta de distancia."

#: Admin/FieldLabels.php:103
msgid "Distance weight"
msgstr "Peso de la distancia"

#: Admin/FieldLabels.php:103
msgid "How strongly distance influences ranking (0–1)."
msgstr "Cuánto influye la distancia en el orden (0–1)."

#: Admin/FieldLabels.php:104
msgid "Price facet"
msgstr "Faceta de precio"

#: Admin/FieldLabels.php:104
msgid "Bucket results by price ranges below. Prices index automatically; no re-index needed to toggle."
msgstr "Agrupa los resultados por los rangos de precio siguientes. Los precios se indexan automáticamente; no requiere reindexación para activar."

#: Admin/FieldLabels.php:105
msgid "Price meta key"
msgstr "Clave meta de precio"

#: Admin/FieldLabels.php:105
msgid "Post meta key holding the numeric price (WooCommerce: _price). Requires a re-index."
msgstr "Clave meta de la entrada con el precio numérico (WooCommerce: _price). Requiere una reindexación."

#: Admin/FieldLabels.php:106
msgid "Price ranges"
msgstr "Rangos de precio"

#: Admin/FieldLabels.php:106
msgid "Comma-separated upper bounds, e.g. 100, 500, 1000. Applied at query time."
msgstr "Límites superiores separados por comas, p. ej. 100, 500, 1000. Se aplica al buscar."

#: Admin/FieldLabels.php:107
msgid "Enable semantic search"
msgstr "Activar búsqueda semántica"

#: Admin/FieldLabels.php:107
msgid "Hybrid keyword + embedding search via an OpenAI-compatible API."
msgstr "Búsqueda híbrida por palabras clave + embeddings mediante una API compatible con OpenAI."

#: Admin/FieldLabels.php:108
msgid "Embedding endpoint"
msgstr "Punto de acceso de embeddings"

#: Admin/FieldLabels.php:108
msgid "Base URL, e.g. https://api.openai.com/v1 or http://localhost:11434/v1"
msgstr "URL base, p. ej. https://api.openai.com/v1 o http://localhost:11434/v1"

#: Admin/FieldLabels.php:109
msgid "API key"
msgstr "Clave de API"

#: Admin/FieldLabels.php:109
msgid "Write-only: blank keeps the stored key. YETISEARCH_SEMANTIC_API_KEY wins."
msgstr "Solo escritura: vacío conserva la clave guardada. YETISEARCH_SEMANTIC_API_KEY tiene prioridad."

#: Admin/FieldLabels.php:110
msgid "Embedding model"
msgstr "Modelo de embeddings"

#: Admin/FieldLabels.php:110
msgid "Model id sent to the embedding endpoint."
msgstr "Identificador del modelo enviado al punto de acceso de embeddings."

#: Admin/FieldLabels.php:111
msgid "Dimensions"
msgstr "Dimensiones"

#: Admin/FieldLabels.php:111
msgid "0 means auto-detect from the first response."
msgstr "0 significa detectar automáticamente desde la primera respuesta."

#: Admin/FieldLabels.php:112
msgid "Query prefix"
msgstr "Prefijo de consulta"

#: Admin/FieldLabels.php:112
msgid "Prepended to queries, e.g. for nomic-embed-text."
msgstr "Se antepone a las consultas, p. ej. para nomic-embed-text."

#: Admin/FieldLabels.php:113
msgid "Document prefix"
msgstr "Prefijo de documento"

#: Admin/FieldLabels.php:113
msgid "Prepended to indexed documents."
msgstr "Se antepone a los documentos indexados."

#: Admin/FieldLabels.php:114
msgid "Semantic weight"
msgstr "Peso semántico"

#: Admin/FieldLabels.php:114
msgid "Hybrid balance between keyword and vector scores."
msgstr "Equilibrio híbrido entre puntuaciones de palabras clave y vectoriales."

#: Admin/FieldLabels.php:115
msgid "Minimum similarity"
msgstr "Similitud mínima"

#: Admin/FieldLabels.php:115
msgid "Vector hits below this are discarded."
msgstr "Los resultados vectoriales por debajo de este valor se descartan."

#: Admin/FieldLabels.php:116
msgid "Minimum margin"
msgstr "Margen mínimo"

#: Admin/FieldLabels.php:116
msgid "Noise gate: semantic must beat keyword by this margin."
msgstr "Puerta de ruido: lo semántico debe superar a las palabras clave por este margen."

#: Admin/FieldLabels.php:117
msgid "Calibration"
msgstr "Calibración"

#: Admin/FieldLabels.php:117
msgid "Auto measures the noise floor; off disables the gate."
msgstr "Auto mide el suelo de ruido; desactivado deshabilita la puerta."

#: Admin/FieldLabels.php:118
msgid "Calibration strictness"
msgstr "Rigor de calibración"

#: Admin/FieldLabels.php:118
msgid "Higher rejects more semantic noise."
msgstr "Un valor mayor rechaza más ruido semántico."

#: Admin/FieldLabels.php:119
msgid "Embedding batch size"
msgstr "Tamaño de lote de embeddings"

#: Admin/FieldLabels.php:119
msgid "Documents embedded per cron/AJAX batch."
msgstr "Documentos con embeddings generados por lote de cron/AJAX."

#: Admin/FieldLabels.php:120
msgid "Query timeout (s)"
msgstr "Tiempo de espera de consulta (s)"

#: Admin/FieldLabels.php:120
msgid "Embedding calls slower than this fall back to keyword search."
msgstr "Las llamadas de embeddings más lentas que esto usan la búsqueda por palabras clave."

#: Admin/FieldLabels.php:121
msgid "Semantic in typeahead"
msgstr "Semántica en sugerencias predictivas"

#: Admin/FieldLabels.php:121
msgid "Off by default to keep keystroke latency low."
msgstr "Desactivado por defecto para mantener baja la latencia al escribir."

#: Admin/FieldLabels.php:122
msgid "Embed via cron"
msgstr "Generar embeddings con cron"

#: Admin/FieldLabels.php:122
msgid "Embed pending documents every five minutes."
msgstr "Genera embeddings de los documentos pendientes cada cinco minutos."

#: Admin/FieldLabels.php:123
msgid "Query cache"
msgstr "Caché de consultas"

#: Admin/FieldLabels.php:123
msgid "Cache search results for repeated queries."
msgstr "Guarda en caché los resultados para consultas repetidas."

#: Admin/FieldLabels.php:124
msgid "Cache TTL (s)"
msgstr "Caducidad de caché (s)"

#: Admin/FieldLabels.php:124
msgid "How long cached results stay valid."
msgstr "Cuánto tiempo permanecen válidos los resultados en caché."

#: Admin/FieldLabels.php:125
msgid "Cache max size"
msgstr "Tamaño máximo de caché"

#: Admin/FieldLabels.php:125
msgid "Maximum cached queries held."
msgstr "Máximo de consultas guardadas en caché."

#: Admin/FieldLabels.php:126
msgid "Warm-up queries"
msgstr "Consultas de precalentamiento"

#: Admin/FieldLabels.php:126
msgid "One per line; replayed after clearing the cache."
msgstr "Una por línea; se repiten tras vaciar la caché."

#: Admin/FieldLabels.php:127
msgid "SQLite synchronous"
msgstr "Sincrónico de SQLite"

#: Admin/FieldLabels.php:127
msgid "FULL is safer, NORMAL is faster."
msgstr "FULL es más seguro, NORMAL es más rápido."

#: Admin/FieldLabels.php:128
msgid "Maximum results"
msgstr "Máximo de resultados"

#: Admin/FieldLabels.php:128
msgid "De-duplication window pulled per search."
msgstr "Ventana de eliminación de duplicados obtenida por búsqueda."

#: Admin/FieldLabels.php:129
msgid "Search mode"
msgstr "Modo de búsqueda"

#: Admin/FieldLabels.php:129
msgid "Fast uses the engine total (may include removed posts); verified recounts public posts within the result window (slower transfer). Items are always verified."
msgstr "Rápido usa el total del motor (puede incluir entradas eliminadas); verificado recuenta las entradas públicas dentro de la ventana de resultados (transferencia más lenta). Los elementos siempre se verifican."

#: Admin/SettingsPage.php:40
#: Admin/SettingsPage.php:41
#: Admin/Views/layout.php:22
msgid "WpYetiSearch\\Vendor\\YetiSearch"
msgstr ""

#: Admin/SettingsPage.php:112
msgid "YetiSearch settings changed the index schema. Please re-index on the Maintenance tab."
msgstr "Los ajustes de YetiSearch han cambiado el esquema del índice. Reindexa en la pestaña de mantenimiento."

#: Admin/Views/field.php:61
msgid "Clear stored key"
msgstr "Borrar la clave guardada"

#: Admin/Views/layout.php:24
msgid "Index schema changed — please re-index on the Maintenance tab."
msgstr "El esquema del índice ha cambiado — reindexa en la pestaña de mantenimiento."

#: Admin/Views/tab-general.php:16
msgid "System health"
msgstr "Estado del sistema"

#: Admin/Views/tab-general.php:22
msgid "OK"
msgstr "Correcto"

#: Admin/Views/tab-general.php:22
msgid "FAIL"
msgstr "Fallo"

#: Admin/Views/tab-general.php:29
msgid "Re-check"
msgstr "Volver a comprobar"

#. translators: %s: human-readable time difference, e.g. "2 hours"
#: Admin/Views/tab-general.php:35
#, php-format
msgid "Last checked %s ago. Automatic checks run hourly."
msgstr "Última comprobación hace %s. Las comprobaciones automáticas se ejecutan cada hora."

#: Admin/Views/tab-general.php:40
msgid "Notice: SQLite 3.35 or newer is recommended for best performance. Search works on your version."
msgstr "Aviso: se recomienda SQLite 3.35 o superior para un mejor rendimiento. La búsqueda funciona en tu versión."

#: Admin/Views/tab-general.php:43
msgid "Search"
msgstr "Búsqueda"

#: Admin/Views/tab-general.php:50
msgid "Locked: health checks are not passing."
msgstr "Bloqueado: las comprobaciones de estado no están pasando."

#: Admin/Views/tab-general.php:59
msgid "Current database:"
msgstr "Base de datos actual:"

#: Admin/Views/tab-general.php:64
msgid "Storage protection"
msgstr "Protección del almacenamiento"

#: Admin/Views/tab-general.php:65
msgid "Server detected:"
msgstr "Servidor detectado:"

#: Admin/Views/tab-general.php:67
