msgid "Content"
msgstr "Contenido"

#: Admin/FieldLabels.php:17
msgid "Relevance"
msgstr "Relevancia"

#: Admin/FieldLabels.php:18
msgid "Language"
msgstr "Idioma"

#: Admin/FieldLabels.php:19
msgid "Display"
msgstr "Visualización"

#: Admin/FieldLabels.php:20
